# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# data storage
/data/

# cloudflare tunnel config (contains credentials)
cloudflared.yml

# claude settings
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev / deploy artifacts
.dev.vars
.wrangler/
.open-next/
/migration-out/
/.shots/
serve.log
nohup.out
.test-files/
